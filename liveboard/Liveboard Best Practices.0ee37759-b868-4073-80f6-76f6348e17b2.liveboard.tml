        expr: "if ( start_of_year ( today ( ) ) = start_of_year ( [date] ) ) then start_of_year ( [date] ) else if ( start_of_year ( add_months ( today ( ) , - 12 ) ) = start_of_year ( [date] ) ) then start_of_year ( [date] ) else null"
        was_auto_generated: false
