  - id: Viz_6
    answer:
      name: Sales by Subcategory Ranking
      description: Top subcategories ranked by total sales.
      tables:
      - id: Sales Model
        name: Sales Model
        fqn: 12bf90fa-0b6a-4cf2-8385-971c53bfb9de
      formulas:
      - id: formula_Salesamount Rank
        name: Salesamount Rank
        expr: "rank ( sum ( [Salesamount] ) , 'desc' )"
        was_auto_generated: false
      search_query: "[Salesamount] [formula_Salesamount Rank] [Subcategory]"
      answer_columns:
      - name: Salesamount Rank
      - name: Subcategory
      - name: Total Salesamount
      table:
        table_columns:
        - column_id: Salesamount Rank
          headline_aggregation: COUNT_DISTINCT
        - column_id: Subcategory
          headline_aggregation: COUNT_DISTINCT
        - column_id: Total Salesamount
          headline_aggregation: SUM
        ordered_column_ids:
        - Subcategory
        - Salesamount Rank
        - Total Salesamount
        client_state: ""
      chart:
        type: PARETO
        chart_columns:
        - column_id: Salesamount Rank
        - column_id: Subcategory
        - column_id: Total Salesamount
        axis_configs:
        - x:
          - Subcategory
          "y":
          - Total Salesamount
        client_state: ""
        viz_style: "{\"overrides\": {\"column_properties\": [{\"column_id\": \"Total Salesamount\",\"properties\": {\"color\": \"#3b6fa0\"}}]}}"
      display_mode: CHART_MODE
    viz_guid: bcb3b23f-3e5c-4672-8f5d-746bc9d46987
