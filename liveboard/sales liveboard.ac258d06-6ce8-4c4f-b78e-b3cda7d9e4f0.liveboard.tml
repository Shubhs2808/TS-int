guid: ac258d06-6ce8-4c4f-b78e-b3cda7d9e4f0
liveboard:
  name: sales liveboard test
  visualizations:
  - id: Viz_1
    answer:
      name: Monthly Distinct Order Count
      description: Unique orders counted by month.
      tables:
      - id: Sales Model
        name: Sales Model
        fqn: 12bf90fa-0b6a-4cf2-8385-971c53bfb9de
      search_query: "unique count [Ordernumber] [Date].monthly"
      answer_columns:
      - name: Month(Date)
      - name: Unique Number of Ordernumber
        format:
          category: NUMBER
          numberFormatConfig:
            unit: NONE
            decimals: 0.0
            toSeparateThousands: true
            removeTrailingZeroes: false
          isCategoryEditable: true
      table:
        table_columns:
        - column_id: Month(Date)
          headline_aggregation: MIN-MAX
        - column_id: Unique Number of Ordernumber
          headline_aggregation: AVERAGE
        ordered_column_ids:
        - Month(Date)
        - Unique Number of Ordernumber
        client_state: ""
      chart:
        type: KPI
        chart_columns:
        - column_id: Month(Date)
        - column_id: Unique Number of Ordernumber
        axis_configs:
        - x:
          - Month(Date)
          "y":
          - Unique Number of Ordernumber
        client_state: ""
        viz_style: "{\"overrides\": {\"column_properties\": [{\"column_id\": \"Unique Number of Ordernumber\",\"properties\": {\"color\": \"#6b95a8\"}}]}}"
      display_mode: CHART_MODE
    viz_guid: bda63dac-ab5b-4b0c-8278-93b07cf36747
  - id: Viz_2
    answer:
      name: Monthly Sales and Profit Totals
      description: Sales and profit by month filtered.
      tables:
      - id: Sales Model
        name: Sales Model
        fqn: 12bf90fa-0b6a-4cf2-8385-971c53bfb9de
      search_query: "sum [Salesamount] sum [Profitamount] [Date].monthly"
      answer_columns:
      - name: Month(Date)
      - name: Total Profitamount
        format:
          category: CURRENCY
          currencyFormatConfig:
            locale: USD
            unit: AUTO
            decimals: 1.0
            toSeparateThousands: true
            removeTrailingZeroes: true
          isCategoryEditable: true
      - name: Total Salesamount
        format:
          category: CURRENCY
          currencyFormatConfig:
            locale: USD
            unit: AUTO
            decimals: 1.0
            toSeparateThousands: true
            removeTrailingZeroes: true
          isCategoryEditable: true
      table:
        table_columns:
        - column_id: Month(Date)
          headline_aggregation: MIN-MAX
        - column_id: Total Profitamount
          headline_aggregation: SUM
        - column_id: Total Salesamount
          headline_aggregation: SUM
        ordered_column_ids:
        - Month(Date)
        - Total Salesamount
        - Total Profitamount
        client_state: ""
      chart:
        type: ADVANCED_LINE
        chart_columns:
        - column_id: Month(Date)
        - column_id: Total Profitamount
        - column_id: Total Salesamount
        client_state: ""
        custom_chart_config:
        - key: basic
          dimensions:
          - key: x-axis
            axes:
            - type: FLAT
              column: Month(Date)
            mode: AXIS_DRIVEN
          - key: y-axis
            axes:
            - type: DUAL
              primary:
                type: FLAT
                column: Total Salesamount
              secondary:
                type: FLAT
                column: Total Profitamount
            mode: AXIS_DRIVEN
          - key: slice-with-color
            mode: AXIS_DRIVEN
          - key: trellis-by
            mode: AXIS_DRIVEN
        viz_style: "{\"overrides\": {\"legend_properties\": {\"show_legend\": true,\"position\": \"BOTTOM_LEGEND\",\"color_palette\": {\"colors\": [\"#b8d4e8\",\"#8fbad6\",\"#3b6fa0\",\"#2d5a82\",\"#1f4563\",\"#b5d8dc\",\"#8cc4cb\",\"#4a7b8c\",\"#3a6270\",\"#2a4a55\",\"#c2dde5\",\"#96c5d1\",\"#5c8a9e\",\"#4a7080\",\"#385662\",\"#ccdfe4\",\"#a3c8d2\",\"#6b95a8\",\"#567888\",\"#415b68\",\"#d4e3ec\",\"#b0cfdc\",\"#7ba3b8\",\"#628494\",\"#4a6570\",\"#dce8ee\",\"#bddae4\",\"#8bb0c2\",\"#6e8f9e\",\"#52707a\",\"#e4edf2\",\"#c8e0ea\",\"#9bbdcc\",\"#7d9aa8\",\"#5f7a84\",\"#ecf2f5\",\"#d4e6ee\",\"#abcad6\",\"#8ca6b2\",\"#6d848e\"]}},\"data_label_properties\": {\"all_labels\": true},\"display_properties\": {\"gridline_properties\": {\"x_gridline_enabled\": false,\"y_gridline_enabled\": false}},\"axis_properties\": [{\"linked_columns\": [\"Total Salesamount\"],\"properties\": {\"is_name_visible\": false,\"is_label_visible\": true}},{\"linked_columns\": [\"Total Profitamount\"],\"properties\": {\"is_name_visible\": false,\"is_label_visible\": true}}]}}"
      display_mode: CHART_MODE
    viz_guid: 41ee1d85-b251-4b89-987b-44b64842113b
  - id: Viz_3
    answer:
      name: Quarterly Sales by Category
      description: Total salesamount across categories by quarter.
      tables:
      - id: Sales Model
        name: Sales Model
        fqn: 12bf90fa-0b6a-4cf2-8385-971c53bfb9de
      search_query: "sum [Salesamount] [Date].quarterly [Category]"
      answer_columns:
      - name: Category
      - name: Quarter(Date)
      - name: Total Salesamount
        format:
          category: CURRENCY
          currencyFormatConfig:
            locale: USD
            unit: AUTO
            decimals: 1.0
            toSeparateThousands: true
            removeTrailingZeroes: true
          isCategoryEditable: true
      table:
        table_columns:
        - column_id: Category
          headline_aggregation: COUNT_DISTINCT
        - column_id: Quarter(Date)
          headline_aggregation: MIN-MAX
        - column_id: Total Salesamount
          headline_aggregation: SUM
        ordered_column_ids:
        - Quarter(Date)
        - Category
        - Total Salesamount
        client_state: ""
      chart:
        type: ADVANCED_STACKED_AREA
        chart_columns:
        - column_id: Category
        - column_id: Quarter(Date)
        - column_id: Total Salesamount
        client_state: ""
        custom_chart_config:
        - key: basic
          dimensions:
          - key: x-axis
            axes:
            - type: FLAT
              column: Quarter(Date)
            mode: AXIS_DRIVEN
          - key: y-axis
            axes:
            - type: FLAT
              column: Total Salesamount
            mode: AXIS_DRIVEN
          - key: slice-with-color
            axes:
            - type: FLAT
              column: Category
            mode: AXIS_DRIVEN
          - key: trellis-by
            mode: AXIS_DRIVEN
        viz_style: "{\"overrides\": {\"legend_properties\": {\"show_legend\": true,\"position\": \"BOTTOM_LEGEND\",\"color_palette\": {\"colors\": [\"#b8d4e8\",\"#8fbad6\",\"#3b6fa0\",\"#2d5a82\",\"#1f4563\",\"#b5d8dc\",\"#8cc4cb\",\"#4a7b8c\",\"#3a6270\",\"#2a4a55\",\"#c2dde5\",\"#96c5d1\",\"#5c8a9e\",\"#4a7080\",\"#385662\",\"#ccdfe4\",\"#a3c8d2\",\"#6b95a8\",\"#567888\",\"#415b68\",\"#d4e3ec\",\"#b0cfdc\",\"#7ba3b8\",\"#628494\",\"#4a6570\",\"#dce8ee\",\"#bddae4\",\"#8bb0c2\",\"#6e8f9e\",\"#52707a\",\"#e4edf2\",\"#c8e0ea\",\"#9bbdcc\",\"#7d9aa8\",\"#5f7a84\",\"#ecf2f5\",\"#d4e6ee\",\"#abcad6\",\"#8ca6b2\",\"#6d848e\"]}},\"data_label_properties\": {\"stack_labels_properties\": {\"is_visible\": true},\"column_data_label_properties\": [{\"column_id\": \"Total Salesamount\",\"properties\": {\"is_visible\": false}}]},\"display_properties\": {\"gridline_properties\": {\"x_gridline_enabled\": false,\"y_gridline_enabled\": false}},\"axis_properties\": [{\"linked_columns\": [\"Total Salesamount\"],\"properties\": {\"is_name_visible\": false,\"is_label_visible\": true}}]}}"
