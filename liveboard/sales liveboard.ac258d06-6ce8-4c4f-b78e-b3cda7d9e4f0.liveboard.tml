  - id: Viz_21
    viz_guid: 3695cec3-99c2-457d-8c44-19cb3628a4e5
    note_tile:
      html_parsed_string: |-
        <p><strong>Sales Performance Overview</strong></p>
        <p><em>Your complete view of commercial health.</em></p>
        <p>This Liveboard tracks core sales metrics—revenue, profit, and quantity—across regions, product categories, customer segments, and individual salespeople. Use the <strong>date_test</strong> parameter to filter all visualizations by your chosen time period.</p>
  - id: Viz_22
    answer:
      name: Monthly Profit Margin This Year
      description: Profit margin percentage by month.
      tables:
      - id: Sales Model
        name: Sales Model
        fqn: 12bf90fa-0b6a-4cf2-8385-971c53bfb9de
      formulas:
      - id: formula_Profit Margin %
        name: Profit Margin %
        expr: "( sum ( [Profitamount] ) / sum ( [Salesamount] ) ) * 100"
        was_auto_generated: false
      search_query: "[formula_Profit Margin %] [Date].monthly [Date] = 'this year'"
      answer_columns:
      - name: Month(Date)
      - name: Profit Margin %
      table:
        table_columns:
        - column_id: Month(Date)
          headline_aggregation: MIN-MAX
        - column_id: Profit Margin %
          headline_aggregation: TABLE_AGGR
        ordered_column_ids:
