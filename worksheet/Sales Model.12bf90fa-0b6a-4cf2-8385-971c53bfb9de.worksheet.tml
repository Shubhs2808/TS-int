  - name: FACTSALES
    fqn: e2798659-c745-4910-9452-93980c72e379
    joins:
    - with: DIMCUSTOMER
      'on': '[FACTSALES::CUSTOMERKEY] = [DIMCUSTOMER::CUSTOMERKEY]'
      type: RIGHT_OUTER
      cardinality: MANY_TO_ONE
    - with: DIMDATE
      'on': '[FACTSALES::DATEKEY] = [DIMDATE::DATEKEY]'
      type: INNER
      cardinality: MANY_TO_ONE
    - with: DIMPRODUCT
      'on': '[FACTSALES::PRODUCTKEY] = [DIMPRODUCT::PRODUCTKEY]'
      type: RIGHT_OUTER
      cardinality: MANY_TO_ONE
    - with: DIMSALESPERSON
      'on': '[FACTSALES::SALESPERSONKEY] = [DIMSALESPERSON::SALESPERSONKEY]'
      type: RIGHT_OUTER
      cardinality: MANY_TO_ONE
    - with: DIMSTORE
      'on': '[FACTSALES::STOREKEY] = [DIMSTORE::STOREKEY]'
      type: RIGHT_OUTER
      cardinality: MANY_TO_ONE
  columns:
  - name: City
