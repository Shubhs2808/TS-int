guid: 12bf90fa-0b6a-4cf2-8385-971c53bfb9de
model:
  name: Sales Model
  model_tables:
  - name: DIMCUSTOMER
    fqn: 67a291fa-1e4a-4074-947d-4f74fef45d5d
  - name: DIMDATE
    fqn: 342f79bf-4d77-42f7-89f2-0d2ee9d62fb7
  - name: DIMPRODUCT
    fqn: c27d28bd-0b17-4362-a8ab-f5d96b740c94
  - name: DIMSALESPERSON
