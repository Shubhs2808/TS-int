guid: 0049ec0f-32f1-4b73-8e4f-a94653388273
model:
  name: case_study_worksheet_new
  description: |2-

    This worksheet contains data that can be used to understand sales performance of a variety of products. It contains information about the date, product, quantity purchased/sold, sales, type, unit costs/retail prices, and other metrics such as inventory and demo. This data can be used to analyze product performance, identify sales trends, and understand how pricing affects sales. It can also be used to forecast future sales, identify potential problems and opportunities, and optimize store operations. (AI generated)
  model_tables:
  - name: D_PRODUCT
    fqn: 6c4f76c9-8b43-4f06-ad0e-a59f81d03ff5
  - name: F_SALES
    fqn: 81365cce-beab-4012-a110-0b80164a9fe3
    joins:
    - with: CUSTOMERS
      'on': '[F_SALES::CUSTOMER_ID] = [CUSTOMERS::CUSTOMER_ID]'
      type: INNER
      cardinality: MANY_TO_ONE
    - with: D_DATE
      referencing_join: F_SALES_to_D_DATE
    - with: D_PRODUCT
      referencing_join: F_SALES_to_D_PRODUCTS
    - with: PRODUCT_STATUS1
      'on': '[F_SALES::PRODUCT_ID] = [PRODUCT_STATUS1::PRODUCT_ID]'
      type: INNER
      cardinality: MANY_TO_ONE
  - name: F_INVENTORY
    fqn: 77481211-7927-43c7-8d32-ab5c5ab6dced
    joins:
    - with: CUSTOMERS
      'on': '[F_INVENTORY::CUSTOMER_ID] = [CUSTOMERS::CUSTOMER_ID]'
      type: INNER
      cardinality: MANY_TO_ONE
    - with: D_DATE
      referencing_join: F_inventory join_to d_date
    - with: D_PRODUCT
      referencing_join: F_INVENTORY_to_D_PRODUCTS
  - name: D_DATE
    fqn: 557eb162-cbc8-43f3-902f-239270def89e
  - name: PRODUCT_STATUS1
    fqn: 4be02467-402c-4186-9dfb-a6683ac1290d
  - name: A_PURCHASE_ORDERS_FACT
    fqn: 682e9d64-311c-45d4-9978-3089b34d630e
    joins:
    - with: D_PRODUCT
      'on': '[A_PURCHASE_ORDERS_FACT::PRODUCT_ID] = [D_PRODUCT::PRODUCT_ID]'
      type: INNER
      cardinality: MANY_TO_ONE
  - name: CUSTOMERS
    fqn: 2fc52b0d-b33b-46c0-ba5f-7724f528ea9c
  formulas:
  - id: formula_day_of_week
    name: day_of_week
    expr: day_of_week ( [D_DATE::DATE] )
  - id: formula_dayofweek
    name: dayofweek
    expr: day_of_week ( [D_DATE::DATE] )
  - id: formula_demo 2
    name: demo 2
    expr: '[D_PRODUCT::UNIT_RETAIL_PRICE_USD] + [b]'
  - id: formula_hyperlink
    name: hyperlink
    expr: concat ( '<span style="color:#1a0dab;text-decoration:underline;cursor:pointer;">' , [D_PRODUCT::PRODUCT_TYPE] , '</span>' )
  - id: formula_inventory
    name: inventory
    expr: '[D_PRODUCT::UNIT_COST_USD] * [F_INVENTORY::QUANTITY_PURCHASED]'
  - id: formula_new date
    name: new date
    expr: to_string ( [D_DATE::DATE] , "%d-%m-%y" )
  - id: formula_percen
    name: percen
    expr: sum ( [formula_Sales] ) / group_aggregate ( sum ( [formula_Sales] ) , { } , { } )
  - id: formula_Sales
    name: Sales
    expr: '[D_PRODUCT::UNIT_RETAIL_PRICE_USD] * [F_SALES::QUANTITY_SOLD]'
  - id: formula_test dollar
    name: test dollar
    expr: '''$'''
  - id: formula_trialadd
    name: trialadd
    expr: '[D_PRODUCT::UNIT_RETAIL_PRICE_USD] * [F_SALES::QUANTITY_SOLD]'
  columns:
  - name: dayofweek
    formula_id: formula_dayofweek
    properties:
      column_type: ATTRIBUTE
      index_type: DONT_INDEX
      synonyms:
      - Weekday
      - Day of the Week
      synonym_type: AUTO_GENERATED
      custom_order:
      - Tuesday
      - Monday
      - Wednesday
      - Thursday
      - Saturday
      - Friday
      ai_context: Weekly day designation enabling analysis of sales patterns and operational performance across different weekdays
  - name: Customer Id
    column_id: CUSTOMERS::CUSTOMER_ID
    properties:
      column_type: ATTRIBUTE
  - name: day_of_week
    formula_id: formula_day_of_week
    properties:
      column_type: ATTRIBUTE
      index_type: DONT_INDEX
      custom_order:
      - tuesday
      - monday
      - wednesday
      - thursday
      - saturday
      - friday
      ai_context: Alternative weekday classification supporting temporal analysis and day-specific business trend identification
  - name: trialadd
    formula_id: formula_trialadd
    properties:
      column_type: MEASURE
      aggregation: SUM
      index_type: DONT_INDEX
      ai_context: Experimental numeric field for testing additional calculations and supplementary business metric development
  - name: inventory
    formula_id: formula_inventory
    properties:
      column_type: MEASURE
      aggregation: SUM
      index_type: DONT_INDEX
      synonyms:
      - Stock
      - Supply
      spotiq_preference: EXCLUDE
      synonym_type: AUTO_GENERATED
      ai_context: Current stock levels on hand for each product enabling supply chain optimization and reorder planning
  - name: revenue
    formula_id: formula_Sales
    properties:
      column_type: MEASURE
      aggregation: SUM
      index_type: DONT_INDEX
      synonyms:
      - Revenue
      - Income
      format_pattern: +#,##0
      synonym_type: AUTO_GENERATED
      ai_context: Total revenue generated from product transactions representing primary business performance indicator
  - name: demo 2
    formula_id: formula_demo 2
    properties:
      column_type: MEASURE
      aggregation: SUM
      index_type: DONT_INDEX
      synonyms:
      - Sample 2
      - Example 2
      synonym_type: AUTO_GENERATED
      ai_context: Secondary demonstration metric used for testing scenarios and analytical model validation purposes
  - name: percen
    formula_id: formula_percen
    properties:
      column_type: MEASURE
      aggregation: SUM
      index_type: DONT_INDEX
      synonyms:
      - Ratio
      - Proportion
      format_pattern: '#.0%'
      synonym_type: AUTO_GENERATED
      ai_context: Percentage-based calculation representing proportional business metrics and performance ratio analysis
  - name: hyperlink
    formula_id: formula_hyperlink
    properties:
      column_type: ATTRIBUTE
      index_type: DONT_INDEX
      ai_context: Web link reference providing external connectivity to related resources or detailed product information
  - name: Product
    description: abc
    column_id: D_PRODUCT::Product
    properties:
      column_type: ATTRIBUTE
      is_attribution_dimension: false
      synonym_type: USER_DEFINED
      custom_order:
      - cookies
      - soap
      - cheese
      - plates
      - napkins
      - eggs
      - ham
      - curd
      ai_context: Primary product name identifier capturing specific retail items including food and non-food categories for inventory and sales analysis
    data_panel_column_groups: {Attribute group: ''}
  - name: fs_Product Id
    column_id: F_SALES::PRODUCT_ID
    properties:
      column_type: ATTRIBUTE
      index_type: DONT_INDEX
      ai_context: Financial system product identifier used for linking products to financial reporting and accounting systems
  - name: Total Cost
    column_id: A_PURCHASE_ORDERS_FACT::TOTAL_COST
    properties:
      column_type: MEASURE
      aggregation: SUM
      index_type: DONT_INDEX
      ai_context: Aggregate cost calculation representing complete financial investment for product procurement and inventory valuation
  - name: Purchase Order Id
    column_id: A_PURCHASE_ORDERS_FACT::PURCHASE_ORDER_ID
    properties:
      column_type: MEASURE
      aggregation: SUM
      index_type: DONT_INDEX
      ai_context: Unique procurement transaction identifier linking purchases to vendor orders and supply chain tracking
  - name: PRODUCT_TYPE
    description: types of product food or non food
    column_id: D_PRODUCT::PRODUCT_TYPE
    properties:
      column_type: ATTRIBUTE
      synonym_type: USER_DEFINED
      custom_order:
      - non-food
      - food
      ai_context: Product category classification distinguishing between food and non-food items for targeted inventory and marketing strategies
    data_panel_column_groups: {Attribute group: ''}
  - name: Product Id
    column_id: F_INVENTORY::PRODUCT_ID
    properties:
      column_type: ATTRIBUTE
      index_type: DONT_INDEX
      synonyms:
      - Item Number
      - Product Number
      spotiq_preference: EXCLUDE
      synonym_type: AUTO_GENERATED
      ai_context: Standard numeric product identifier serving as primary key for product catalog management and cross-system integration
  - name: Product Id1
    column_id: PRODUCT_STATUS1::PRODUCT_ID
    properties:
      column_type: MEASURE
      aggregation: SUM
      index_type: DONT_INDEX
  - name: Status
    column_id: PRODUCT_STATUS1::STATUS
    properties:
      column_type: ATTRIBUTE
      ai_context: Operational state indicator with binary values tracking process completion or business condition flags
  - name: Unit Cost Usd
    column_id: D_PRODUCT::UNIT_COST_USD
    properties:
      column_type: MEASURE
      aggregation: SUM
      index_type: DONT_INDEX
      synonyms:
      - Unit Price Usd
      - Unit Cost Dollar
      currency_type:
        column: test dollar
      synonym_type: AUTO_GENERATED
      ai_context: Individual product procurement cost in US dollars used for margin analysis and pricing strategy development
  - name: Unit Retail Price Usd
    column_id: D_PRODUCT::UNIT_RETAIL_PRICE_USD
    properties:
      column_type: MEASURE
      aggregation: SUM
      index_type: DONT_INDEX
      synonyms:
      - Retail Price Usd
      - Retail Cost Dollar
      synonym_type: AUTO_GENERATED
      ai_context: Customer-facing selling price per unit in US dollars determining revenue generation and profit margins
  - name: Quantity Sold
    column_id: F_SALES::QUANTITY_SOLD
    properties:
      column_type: MEASURE
      aggregation: SUM
      index_type: DONT_INDEX
      synonyms:
      - Amount Sold
      - Number Sold
      synonym_type: AUTO_GENERATED
      ai_context: Number of units sold to customers measuring product demand and market performance
  - name: Date Id
    column_id: D_DATE::DATE_ID
    properties:
      column_type: ATTRIBUTE
      index_type: DONT_INDEX
      synonyms:
      - Date Number
      - Date Code
      synonym_type: AUTO_GENERATED
      ai_context: Numeric date identifier facilitating efficient date-based queries and temporal data analysis operations
  - name: Date
    column_id: D_DATE::DATE
    properties:
      column_type: ATTRIBUTE
      index_type: DONT_INDEX
      synonyms:
      - Day
      format_pattern: yyyy/MM/DD
      synonym_type: AUTO_GENERATED
      ai_context: Transaction date in standard format enabling chronological analysis and time-series business performance tracking
  - name: Is Holiday
    column_id: D_DATE::IS_HOLIDAY
    properties:
      column_type: ATTRIBUTE
      index_type: DONT_INDEX
      synonyms:
      - Vacation
      - Leave
      synonym_type: AUTO_GENERATED
      ai_context: Binary indicator identifying holiday periods for analyzing seasonal sales impact and special event performance
  - name: Quantity Purchased
    column_id: F_INVENTORY::QUANTITY_PURCHASED
    properties:
      column_type: MEASURE
      aggregation: SUM
      index_type: DONT_INDEX
      synonyms:
      - Quantity Bought
      - Quantity Acquired
      synonym_type: AUTO_GENERATED
      ai_context: Number of units acquired from vendors tracking procurement volume and supplier relationship activity
  - name: Vendor Id
    column_id: A_PURCHASE_ORDERS_FACT::VENDOR_ID
    properties:
      column_type: ATTRIBUTE
      index_type: DONT_INDEX
      ai_context: Numeric supplier identifier for vendor performance analysis and procurement relationship management
  - name: Vendor Id Varchar
    column_id: A_PURCHASE_ORDERS_FACT::VENDOR_ID_VARCHAR
    properties:
      column_type: ATTRIBUTE
      ai_context: Text-based vendor identifier providing alternative supplier coding system for vendor management processes
  - name: new date
    formula_id: formula_new date
    properties:
      column_type: ATTRIBUTE
      index_type: DONT_INDEX
      ai_context: Alternative date representation in text format supporting flexible temporal analysis and reporting requirements
  - name: test dollar
    formula_id: formula_test dollar
    properties:
      column_type: ATTRIBUTE
      index_type: DONT_INDEX
      ai_context: Text-based monetary test field containing dollar-formatted values for system validation and data quality verification
  properties:
    is_bypass_rls: false
    join_progressive: true
    spotter_config:
      is_spotter_enabled: true
  parameters:
  - id: ef1b2ece-5fcc-4cf4-8dad-90821931f626
    name: b
    data_type: INT64
    default_value: '1'
    description: ''
  column_groups:
  - type: DATA_PANEL
    properties:
      status: ENABLE
      default_sort: ENABLE
    column_group_info:
    - name: Attribute group
      include_ungrouped_columns: true
